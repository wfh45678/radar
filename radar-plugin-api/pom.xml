<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- groupId=cn.riskengine（riskengine.cn 反向域名）：Maven Central 要求 groupId 为已验证命名空间，
         com.pgmmers 无法验证域名故不用于发布；主工程坐标 com.pgmmers:radar 不上 Central，保持不变 -->
    <groupId>cn.riskengine</groupId>
    <artifactId>radar-plugin-api</artifactId>
    <version>4.0.0</version>
    <packaging>jar</packaging>

    <name>Radar Plugin API</name>
    <description>
        Radar 风控引擎 preItem 插件开发契约（SDK）。
        零第三方依赖（仅 slf4j-api provided）：厂商只需依赖本模块即可开发插件 jar，
        放入引擎 plugins/ 目录即可被发现。详见 docs/plugin-dev-guide.md。
        注意：独立工程，构建主工程前需先 `mvn install` 本模块（CI/脚本已编排）。
    </description>
    <url>https://gitee.com/freshday/radar</url>

    <licenses>
        <license>
            <name>Mulan Permissive Software License, Version 2 (PSL-2.0)</name>
            <url>https://license.coscl.org.cn/MulanPSL2</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>wangfeihu</id>
            <name>wangfeihu</name>
            <email>wangfeihu@chongho.net</email>
        </developer>
    </developers>

    <scm>
        <url>https://gitee.com/freshday/radar</url>
        <connection>scm:git:https://gitee.com/freshday/radar.git</connection>
        <developerConnection>scm:git:https://gitee.com/freshday/radar.git</developerConnection>
    </scm>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- 唯一对外暴露的依赖：日志门面（provided，运行时由引擎类路径提供，厂商插件不打包） -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.16</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 以下四件为 Maven Central 发布硬要求（sources + javadoc + 全工件 GPG 签名 + Portal 上传），
                 仅 deploy 阶段生效，日常 install/编译不受影响 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <configuration>
                    <charset>UTF-8</charset>
                    <encoding>UTF-8</encoding>
                    <docencoding>UTF-8</docencoding>
                    <doclint>none</doclint>
                    <failOnError>false</failOnError>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.2.6</version>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.12.0</version>
                <extensions>true</extensions>
                <configuration>
                    <!-- 对应 settings.xml 里 <server><id>central-portal</id>（Central Portal 用户令牌，
                         本地配于 ~/.m2/settings.xml，CI 配于 GitHub Secrets） -->
                    <publishingServerId>central-portal</publishingServerId>
                    <!-- 自动发布：tag 驱动的 release（本地/CI）上传即发布；
                        Central 版本不可变，发布失败需升版本号重试 -->
                    <autoPublish>true</autoPublish>
                    <excludeBuildDirectory>true</excludeBuildDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
